{
  "packId": "lifescribe-default",
  "packVersion": "2.1.0",
  "schemaVersion": 1,
  "minAppVersion": "0.2.0",
  "sections": [
    {
      "sectionKey": "digital-executors",
      "title": "Digital Executors",
      "lede": "Choose the people who can coordinate with family, legal contacts, and service providers to locate, access, preserve, transfer, or close your digital accounts and devices. A digital executor is the person your family will actually call — naming them now, and telling them, saves your family weeks of chaos later.",
      "multiRecord": false,
      "order": 1,
      "groups": [
        {
          "groupKey": "executor",
          "title": "Executor",
          "repeatable": true,
          "minRecords": 1,
          "order": 1,
          "fields": [
            {
              "systemKey": "executorName",
              "label": "Full name",
              "type": "text",
              "required": true,
              "protected": true,
              "order": 1
            },
            {
              "systemKey": "executorRole",
              "label": "Role",
              "helperText": "Primary executors act first; backups step in when the primary cannot.",
              "type": "select",
              "required": true,
              "protected": true,
              "options": [
                {
                  "value": "primary",
                  "label": "Primary"
                },
                {
                  "value": "backup",
                  "label": "Backup"
                }
              ],
              "order": 2
            },
            {
              "systemKey": "executorRelationship",
              "label": "Relationship",
              "helperText": "How this person is connected to you — spouse, sibling, close friend, attorney.",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 3
            },
            {
              "systemKey": "executorAddress",
              "label": "Address",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 4
            },
            {
              "systemKey": "executorCity",
              "label": "City",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 5
            },
            {
              "systemKey": "executorState",
              "label": "State",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 6
            },
            {
              "systemKey": "executorZipCode",
              "label": "Zip code",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 7
            },
            {
              "systemKey": "executorPhoneNumber",
              "label": "Phone number",
              "type": "phone",
              "required": false,
              "protected": false,
              "order": 8
            },
            {
              "systemKey": "executorEmail",
              "label": "Email",
              "type": "email",
              "required": false,
              "protected": false,
              "order": 9
            },
            {
              "systemKey": "executorResponsibilities",
              "label": "Responsibilities",
              "helperText": "What you would like this person to handle — accounts to close, photos to preserve, people to notify.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 10
            },
            {
              "systemKey": "executorStepIn",
              "label": "When this person should step in",
              "helperText": "For example: if the primary executor is unreachable for two weeks, or is unable to act.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "visibleWhen": {
                "field": "executorRole",
                "equals": "backup"
              },
              "order": 11
            },
            {
              "systemKey": "executorInformed",
              "label": "Informed status",
              "helperText": "An executor who doesn't know they're an executor can't help. A short conversation now spares them confusion later.",
              "type": "select",
              "required": false,
              "protected": false,
              "options": [
                {
                  "value": "informed",
                  "label": "Informed"
                },
                {
                  "value": "not-informed",
                  "label": "Not informed yet"
                }
              ],
              "order": 12
            },
            {
              "systemKey": "executorLastConfirmedAt",
              "label": "Last confirmation date",
              "helperText": "When you last confirmed this person is still willing and reachable.",
              "type": "date",
              "required": false,
              "protected": false,
              "order": 13
            }
          ]
        }
      ],
      "readinessRule": {
        "requiredKeys": [
          "executorName",
          "executorRole"
        ]
      },
      "kitMapping": {
        "entries": [
          {
            "heading": "Who to contact first",
            "fields": [
              "executorName",
              "executorRole",
              "executorRelationship",
              "executorPhoneNumber",
              "executorEmail",
              "executorResponsibilities",
              "executorStepIn"
            ]
          }
        ]
      }
    },
    {
      "sectionKey": "password-manager",
      "title": "Password Manager",
      "lede": "This vault is a companion to your password manager, not a replacement for it. Your passwords stay in the manager — here you record how a trusted person would gain emergency access to it. That one plan unlocks almost everything else, so it's worth getting right.",
      "multiRecord": false,
      "order": 2,
      "groups": [
        {
          "groupKey": "plan",
          "title": "Password manager plan",
          "repeatable": false,
          "order": 1,
          "fields": [
            {
              "systemKey": "passwordManagerProvider",
              "label": "Password manager provider",
              "helperText": "Which password manager you use.",
              "type": "select",
              "required": true,
              "protected": true,
              "options": [
                {
                  "value": "1Password",
                  "label": "1Password"
                },
                {
                  "value": "Bitwarden",
                  "label": "Bitwarden"
                },
                {
                  "value": "Dashlane",
                  "label": "Dashlane"
                },
                {
                  "value": "Keeper",
                  "label": "Keeper"
                },
                {
                  "value": "LastPass",
                  "label": "LastPass"
                },
                {
                  "value": "NordPass",
                  "label": "NordPass"
                },
                {
                  "value": "Proton Pass",
                  "label": "Proton Pass"
                },
                {
                  "value": "Apple Passwords / iCloud Keychain",
                  "label": "Apple Passwords / iCloud Keychain"
                },
                {
                  "value": "Google Password Manager",
                  "label": "Google Password Manager"
                },
                {
                  "value": "Microsoft Edge / Microsoft Authenticator",
                  "label": "Microsoft Edge / Microsoft Authenticator"
                },
                {
                  "value": "Other",
                  "label": "Other"
                }
              ],
              "order": 1
            },
            {
              "systemKey": "passwordManagerOtherProvider",
              "label": "Other provider name",
              "type": "text",
              "required": false,
              "protected": false,
              "visibleWhen": {
                "field": "passwordManagerProvider",
                "equals": "Other"
              },
              "order": 2
            },
            {
              "systemKey": "passwordManagerAccountIdentifier",
              "label": "Username (Account identifier)",
              "helperText": "Account reference: Email address, Username, or Account ID",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 3
            },
            {
              "systemKey": "passwordManagerMasterPassword",
              "label": "Master password",
              "helperText": "Optional. The master password for your password manager.",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 4
            },
            {
              "systemKey": "passwordManagerEmergencyAccess",
              "label": "Emergency access method",
              "helperText": "How a trusted person gets in — for example 1Password family recovery, Bitwarden Emergency Access with a waiting period, or a sealed recovery kit. Describe the steps, not the secrets.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 5
            },
            {
              "systemKey": "passwordManagerRecoveryLocation",
              "label": "Recovery material location",
              "helperText": "Where the printed emergency kit or recovery codes are kept — a location like \"the fireproof box in the hall closet\", never the codes themselves.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 6
            },
            {
              "systemKey": "passwordManagerTwoFactorNotes",
              "label": "2FA or passkey recovery notes",
              "helperText": "How two-factor codes or passkeys would be recovered — which authenticator app, which device, where backup codes live. Locations and steps only, never the codes.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 7
            },
            {
              "systemKey": "passwordManagerTrustedEmergencyContact",
              "label": "Trusted emergency contact",
              "helperText": "Who holds emergency access or knows where the recovery material is, and how to reach them.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 8
            },
            {
              "systemKey": "passwordManagerAccessTested",
              "label": "Access-tested status",
              "helperText": "An emergency plan that has never been rehearsed often fails when it matters. A ten-minute dry run is worth it.",
              "type": "select",
              "required": false,
              "protected": false,
              "options": [
                {
                  "value": "tested",
                  "label": "Tested"
                },
                {
                  "value": "not-tested",
                  "label": "Not tested yet"
                }
              ],
              "order": 9
            },
            {
              "systemKey": "passwordManagerExecutorInstructions",
              "label": "Executor instructions",
              "helperText": "Plain-language steps your executor should follow first, written for someone who may not be technical.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 10
            }
          ]
        }
      ],
      "readinessRule": {
        "requiredKeys": [
          "passwordManagerProvider"
        ]
      },
      "kitMapping": {
        "entries": [
          {
            "heading": "Password manager emergency access",
            "fields": [
              "passwordManagerProvider",
              "passwordManagerOtherProvider",
              "passwordManagerAccountIdentifier",
              "passwordManagerEmergencyAccess",
              "passwordManagerRecoveryLocation",
              "passwordManagerTrustedEmergencyContact",
              "passwordManagerExecutorInstructions"
            ]
          }
        ]
      }
    },
    {
      "sectionKey": "devices",
      "title": "Device Inventory",
      "lede": "A locked phone is one of the first walls families hit — photos, messages, and authenticator apps all behind one passcode. List the devices that matter and where a hint to each one is kept, so your family isn't locked out of your life's records.",
      "multiRecord": true,
      "order": 3,
      "groups": [
        {
          "groupKey": "device",
          "title": "Device",
          "repeatable": false,
          "order": 1,
          "fields": [
            {
              "systemKey": "deviceName",
              "label": "Device name",
              "helperText": "A name your family would recognize — \"Mom's iPhone\", \"the gray work laptop\".",
              "type": "text",
              "required": true,
              "protected": true,
              "order": 1
            },
            {
              "systemKey": "deviceType",
              "label": "Device type",
              "type": "select",
              "required": false,
              "protected": false,
              "options": [
                {
                  "value": "computer",
                  "label": "Computer"
                },
                {
                  "value": "phone",
                  "label": "Phone"
                },
                {
                  "value": "tablet",
                  "label": "Tablet"
                },
                {
                  "value": "nas",
                  "label": "NAS"
                },
                {
                  "value": "external-drive",
                  "label": "External drive"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ],
              "order": 2
            },
            {
              "systemKey": "deviceOwner",
              "label": "Owner or main user",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 3
            },
            {
              "systemKey": "deviceUnlockHintLocation",
              "label": "Unlock hint location",
              "helperText": "Where a hint to the PIN or passcode is stored — for example \"sealed envelope in the safe\".",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 4
            },
            {
              "systemKey": "deviceRecoveryNotes",
              "label": "Recovery notes",
              "helperText": "Anything else that helps — linked accounts, backup locations, whether the device is encrypted, repair shop contacts.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 5
            },
            {
              "systemKey": "devicePin",
              "label": "PIN or passcode",
              "helperText": "Optional. The unlock PIN or passcode for this device.",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 6
            }
          ]
        }
      ],
      "readinessRule": {
        "requiredKeys": [
          "deviceName"
        ]
      },
      "kitMapping": {
        "entries": [
          {
            "heading": "Devices your family may need to unlock",
            "fields": [
              "deviceName",
              "deviceType",
              "deviceOwner",
              "deviceUnlockHintLocation",
              "deviceRecoveryNotes"
            ]
          }
        ]
      }
    },
    {
      "sectionKey": "financial-accounts",
      "title": "Financial Accounts",
      "lede": "Your family can't close, transfer, or even find what they don't know exists. You don't need account numbers or balances here — just an inventory of which institutions are part of your life, and what should happen to each one.",
      "multiRecord": true,
      "order": 4,
      "groups": [
        {
          "groupKey": "account",
          "title": "Account",
          "repeatable": false,
          "order": 1,
          "fields": [
            {
              "systemKey": "accountInstitution",
              "label": "Institution or service name",
              "helperText": "The bank, broker, insurer, or subscription service — \"Chase\", \"Vanguard\", \"Netflix\".",
              "type": "text",
              "required": true,
              "protected": true,
              "order": 1
            },
            {
              "systemKey": "accountType",
              "label": "Account type",
              "type": "select",
              "required": false,
              "protected": false,
              "options": [
                {
                  "value": "checking",
                  "label": "Checking"
                },
                {
                  "value": "savings",
                  "label": "Savings"
                },
                {
                  "value": "brokerage",
                  "label": "Brokerage"
                },
                {
                  "value": "retirement",
                  "label": "Retirement"
                },
                {
                  "value": "credit-card",
                  "label": "Credit card"
                },
                {
                  "value": "loan",
                  "label": "Loan"
                },
                {
                  "value": "insurance",
                  "label": "Insurance"
                },
                {
                  "value": "subscription",
                  "label": "Subscription"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ],
              "order": 2
            },
            {
              "systemKey": "accountAccessLocation",
              "label": "Where access info lives",
              "helperText": "For example \"in my password manager\" or \"statements arrive by mail\". A pointer only — never credentials or account numbers.",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 3
            },
            {
              "systemKey": "accountInstructions",
              "label": "What should happen to it",
              "helperText": "Close it, transfer it, cancel it — and anything your family should know first, like autopays that depend on it.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 4
            }
          ]
        }
      ],
      "readinessRule": {
        "requiredKeys": [
          "accountInstitution"
        ]
      },
      "kitMapping": {
        "entries": [
          {
            "heading": "Financial accounts and subscriptions",
            "fields": [
              "accountInstitution",
              "accountType",
              "accountAccessLocation",
              "accountInstructions"
            ]
          }
        ]
      }
    },
    {
      "sectionKey": "subscriptions",
      "title": "Subscriptions",
      "lede": "Your family can't close, transfer, or even find what they don't know exists. Provide an inventory of which subscriptions are part of your life, and what should happen to each one.",
      "multiRecord": true,
      "order": 5,
      "groups": [
        {
          "groupKey": "subscription",
          "title": "Subscription",
          "repeatable": false,
          "order": 1,
          "fields": [
            {
              "systemKey": "subscriptionName",
              "label": "Subscription",
              "helperText": "The service this entry is for — a streaming plan, a membership, a recurring app or utility.",
              "type": "text",
              "required": true,
              "protected": true,
              "order": 1
            },
            {
              "systemKey": "subscriptionAction",
              "label": "Action",
              "helperText": "What you'd like done with this subscription when the time comes.",
              "type": "select",
              "required": true,
              "protected": false,
              "order": 2,
              "options": [
                {
                  "value": "keep",
                  "label": "Keep"
                },
                {
                  "value": "cancel",
                  "label": "Cancel"
                },
                {
                  "value": "optional",
                  "label": "Optional"
                }
              ]
            },
            {
              "systemKey": "field_1785343571564_a2230",
              "label": "Cost",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 3,
              "helperText": "Monthly or annual cost with any additional details."
            },
            {
              "systemKey": "subscriptionNotes",
              "label": "Notes",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 4,
              "helperText": "Additional details about the subscription that may provide additional information on the action."
            }
          ]
        }
      ],
      "readinessRule": {
        "requiredKeys": [
          "subscriptionName"
        ]
      },
      "kitMapping": {
        "entries": [
          {
            "heading": "Subscriptions",
            "fields": [
              "subscriptionName",
              "subscriptionAction",
              "subscriptionNotes"
            ]
          }
        ]
      }
    },
    {
      "sectionKey": "online-accounts",
      "title": "Online Accounts",
      "lede": "Email, cloud storage, social profiles, domain names, creator and business accounts — each one is something your family may need to keep alive, hand off, or close with dignity. List what exists and what you'd like done, so nothing important quietly expires or lingers.",
      "multiRecord": true,
      "order": 6,
      "groups": [
        {
          "groupKey": "account",
          "title": "Account",
          "repeatable": false,
          "order": 1,
          "fields": [
            {
              "systemKey": "onlineServiceName",
              "label": "Service name",
              "helperText": "The service or site — \"Gmail\", \"Dropbox\", \"my photography site at example.com\".",
              "type": "text",
              "required": true,
              "protected": true,
              "order": 1
            },
            {
              "systemKey": "onlineAccountKind",
              "label": "Account Type",
              "type": "select",
              "required": false,
              "protected": false,
              "options": [
                {
                  "value": "email",
                  "label": "Email"
                },
                {
                  "value": "cloud-storage",
                  "label": "Cloud storage"
                },
                {
                  "value": "social",
                  "label": "Social"
                },
                {
                  "value": "domain",
                  "label": "Domain name"
                },
                {
                  "value": "website",
                  "label": "Website"
                },
                {
                  "value": "creator",
                  "label": "Creator account"
                },
                {
                  "value": "business",
                  "label": "Business account"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ],
              "order": 2
            },
            {
              "systemKey": "onlineUsername",
              "label": "Username or profile",
              "helperText": "The handle, profile URL, or address — enough for your family to find the right account.",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 3
            },
            {
              "systemKey": "field_1785343366863_1eerk",
              "label": "Access stored in password manager?",
              "type": "select",
              "required": true,
              "protected": false,
              "order": 4,
              "options": [
                {
                  "value": "yes",
                  "label": "Yes"
                },
                {
                  "value": "no",
                  "label": "No"
                }
              ]
            },
            {
              "systemKey": "onlineAccessLocation",
              "label": "Where access info lives",
              "helperText": "Access location if not stored in password manager.",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 5
            },
            {
              "systemKey": "onlineWishes",
              "label": "What you'd like done with it",
              "helperText": "Memorialize it, delete it, transfer it to someone, keep the domain renewed — whatever feels right to you.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 6
            }
          ]
        }
      ],
      "readinessRule": {
        "requiredKeys": [
          "onlineServiceName"
        ]
      },
      "kitMapping": {
        "entries": [
          {
            "heading": "Online accounts and domains",
            "fields": [
              "onlineServiceName",
              "onlineAccountKind",
              "onlineUsername",
              "onlineAccessLocation",
              "onlineWishes"
            ]
          }
        ]
      }
    },
    {
      "sectionKey": "documents",
      "title": "Documents",
      "lede": "Wills, deeds, insurance policies, medical directives — your family will need them fast, and \"somewhere in the office\" is not a location. A short list of where each important document lives can save them days of searching at the worst possible time.",
      "multiRecord": true,
      "order": 7,
      "groups": [
        {
          "groupKey": "document",
          "title": "Document",
          "repeatable": false,
          "order": 1,
          "fields": [
            {
              "systemKey": "documentTitle",
              "label": "Document title",
              "type": "text",
              "required": true,
              "protected": true,
              "order": 1
            },
            {
              "systemKey": "documentCategory",
              "label": "Category",
              "type": "select",
              "required": false,
              "protected": false,
              "options": [
                {
                  "value": "legal",
                  "label": "Legal"
                },
                {
                  "value": "medical",
                  "label": "Medical"
                },
                {
                  "value": "financial",
                  "label": "Financial"
                },
                {
                  "value": "estate",
                  "label": "Estate"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ],
              "order": 2
            },
            {
              "systemKey": "documentPhysicalLocation",
              "label": "Physical location",
              "helperText": "For example: the fireproof box in the hall closet, the safe-deposit box at First National, or your attorney's office.",
              "type": "text",
              "required": false,
              "protected": false,
              "order": 3
            },
            {
              "systemKey": "documentDigitalLocation",
              "label": "Digital location",
              "helperText": "Where a scanned or digital copy lives — a folder path, cloud drive, or shared family folder. Use Choose folder / Choose file to pick it, or type the path.",
              "type": "path",
              "required": false,
              "protected": false,
              "order": 4
            },
            {
              "systemKey": "documentDigitalFile",
              "label": "Attached copy",
              "helperText": "Optional. A scanned or digital copy of this document, attached to the vault.",
              "type": "file",
              "required": false,
              "protected": false,
              "order": 5
            },
            {
              "systemKey": "documentAccessNotes",
              "label": "Notes",
              "helperText": "Anything needed to reach it — who has the safe key, which attorney to call, whose name the box is under.",
              "type": "textarea",
              "required": false,
              "protected": false,
              "order": 6
            }
          ]
        }
      ],
      "readinessRule": {
        "requiredKeys": [
          "documentTitle"
        ]
      },
      "kitMapping": {
        "entries": [
          {
            "heading": "Important documents and where they live",
            "fields": [
              "documentTitle",
              "documentCategory",
              "documentPhysicalLocation",
              "documentDigitalLocation",
              "documentDigitalFile",
              "documentAccessNotes"
            ]
          }
        ]
      }
    },
    {
      "sectionKey": "backups",
      "title": "Backups & Storage",
      "lede": "Backups are where the irreplaceable things live — decades of photos, tax records, the family videos. Record where each backup is, what's on it, and how to get in, so the copy you so carefully kept doesn't become one more thing nobody can open.",
      "multiRecord": true,
      "order": 8,
      "groups": [
        {
          "groupKey": "backup",
          "title": "Backup",
          "repeatable": false,
          "order": 1,
          "fields": [
            {
              "systemKey": "backupLocation",
              "label": "Backup physical location",
              "helperText": "Where it physically or digitally lives — \"the black external drive in the desk drawer\", \"My desktop computer\", \"Backblaze under my main email\".",
              "type": "textarea",
              "required": true,
              "protected": true,
              "order": 1
            },
            {
              "systemKey": "field_1785342259535_nbwd2",
              "label": "Backup computer location",
              "type": "path",
