{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeScribe Vault 2",
  "version": "0.2.0",
  "identifier": "com.lifescribe.vault.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LifeScribe Vault",
        "width": 1440,
        "height": 1000,
        "minWidth": 1220,
        "minHeight": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": ["resources/packs/default-pack.json"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Local-first encrypted digital legacy vault",
    "longDescription": "LifeScribe Vault keeps your digital estate organized and encrypted on your own machine. Guided sections cover executors, passwords, documents, devices, financial accounts, online accounts, platform legacy tools, and backups — so the people you trust can act without guesswork.",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  }
}
