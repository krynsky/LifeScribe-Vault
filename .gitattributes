# Form-pack JSON is written by tooling with LF (the pack-editor save endpoint)
# and byte-compared in tests (saveArtifacts drift + round-trip guards). Pin
# these to LF so they are NOT smudged to CRLF on checkout under
# core.autocrlf=true — otherwise the byte-exact tests fail and every editor
# save rewrites the whole file.
apps/desktop/src-tauri/resources/packs/*.json text eol=lf
